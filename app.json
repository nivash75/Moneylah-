{
  "expo": {
    "name": "Moneylah!",
    "slug": "moneylah",
    "scheme": "moneylah",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pocketledger.t56mtmagbkk",
      "appleTeamId": "56MTMAGBKK"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0B3D2E"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your financial records with Face ID."
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.pocketledger.t56mtmagbkk.widgets",
          "groupIdentifier": "group.com.pocketledger.t56mtmagbkk",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "MonthWidget",
              "displayName": "This month",
              "description": "Income, spending and budget for the current month.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110,
                "initialLayout": "src/widgets/MonthWidget.android.tsx"
              }
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ],
      "./plugins/shortcut/withAddTransactionShortcut"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.pocketledger.moneylah",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B3D2E"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    }
  }
}
